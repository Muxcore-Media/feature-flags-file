# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=true

# Module identity
# MUXCORE_MODULE_ID=feature-flags-file

# Module-specific settings
# FEATURE_FLAGS_FILE=flags.yaml
# FEATURE_FLAGS_GRPC_ADDR=:9402
# FEATURE_FLAGS_HTTP_ADDR=:9404

# MVP stack (_mvp/run-host.sh)
# MVP_ENABLE_FEATURE_FLAGS=1

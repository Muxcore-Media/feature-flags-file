# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=true

# Module identity
# MUXCORE_MODULE_ID=feature-flags-file

# Module-specific settings
# FEATURE_FLAGS_FILE=flags.yaml
# FEATURE_FLAGS_TLS_DIR=   # auto-generated TLS certs when unset
# MUXCORE_TLS_CERT=        # optional explicit server cert
# MUXCORE_TLS_KEY=         # optional explicit server key

[Unit]
Description=MuxCore Module - feature-flags-file
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muxcore
Group=muxcore
Environment=FEATURE_FLAGS_FILE=/var/lib/feature-flags-file/flags.yaml
ExecStart=/usr/local/bin/feature-flags-file \
  --muxcore-mesh-addr localhost:9090 \
  --muxcore-module-id feature-flags-file
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

; Security hardening
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/feature-flags-file

[Install]
WantedBy=multi-user.target
